# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# Case-study raw screenshots (originals stay local; only optimized copies ship).
public/case-studies/**/_raw/
next-env.d.ts

# Impeccable critique snapshots (local archive, not source)
.impeccable/

# Local Claude Code settings (skills under .claude/skills/ ARE tracked)
.claude/settings.local.json

# Throwaway review renders. Sandbox ROUTES are tracked; these are not.
public/sandbox/_*
public/sandbox/figure-framing.*

# Handoff prompts staged from Cowork. Never source.
/_prompts/
