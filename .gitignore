# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# Case-study raw screenshots (originals stay local; only optimized copies ship).
public/case-studies/**/_raw/
next-env.d.ts

# Impeccable critique snapshots (local archive, not source)
.impeccable/

# Local Claude Code settings (skills under .claude/skills/ ARE tracked)
.claude/settings.local.json

# Throwaway review renders. Sandbox ROUTES are tracked; these are not.
public/sandbox/_*
public/sandbox/figure-framing.*

# Handoff prompts staged from Cowork. Never source.
/_prompts/

# Staging artifacts from other tooling. Never source, and large enough to matter:
# a 68MB whole-repo tarball landed here mid-session and was only kept out of a
# commit because files were staged by name rather than with `git add -A`.
/_to_delete/

# Internal reviews. THIS REPOSITORY IS PUBLIC. These are candid working
# documents — the director review grades the portfolio and inventories its
# weaknesses by name — which is useful to write and wrong to publish next to
# the portfolio it critiques. The files stay on disk; they just never ship.
docs/reviews/

# Generated previews. uxpaul-commissioner.html is a ~1 MB capture of a BUILD,
# not a source file: it goes stale the moment app/page.tsx changes, and it goes
# stale silently, because a stale capture still renders perfectly. Regenerate
# with `node scripts/capture-commissioner-preview.mjs`. The bench beside it IS
# committed - it is hand-authored and depends on nothing. Neither the capture
# script nor docs/previews/README.md is on main yet; both arrive with
# commissioner-preview, and this rule is kept ahead of them deliberately, so
# that merge cannot land the 1 MB file while the ignore is still missing.
/docs/previews/uxpaul-commissioner.html

# line-break measurement output
measurements/
